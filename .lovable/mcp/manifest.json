{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://qzurwsqecdsgziyvnuul.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "kova-io",
      "version": "0.1.0",
      "title": "Kova io"
    },
    "tools": [
      {
        "name": "list_workspaces",
        "title": "List workspaces",
        "description": "List the ventures/organisations (workspaces) the signed-in user belongs to, with slug, name, role and status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "include_archived": {
              "type": "boolean",
              "description": "Include archived workspaces. Defaults to false."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List the signed-in user's tasks, optionally filtered by workspace slug and state.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "org": {
              "type": "string",
              "description": "Workspace slug from list_workspaces. Omit for all workspaces."
            },
            "state": {
              "type": "string",
              "enum": [
                "todo",
                "doing",
                "blocked",
                "done"
              ],
              "description": "Filter by task state."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max rows. Defaults to 25."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_task",
        "title": "Create task",
        "description": "Create a task for the signed-in user in one of their workspaces.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "What needs doing."
            },
            "org": {
              "type": "string",
              "description": "Workspace slug from list_workspaces. Omit for a cross-workspace task."
            },
            "project": {
              "type": "string",
              "description": "Project name this task belongs to."
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "description": "Defaults to medium."
            },
            "due_at": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 due date/time."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_knowledge",
        "title": "Search knowledge base",
        "description": "Full-text search across the signed-in user's knowledge documents. Returns matching titles and excerpts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "description": "Words to look for in document titles and bodies."
            },
            "org": {
              "type": "string",
              "description": "Workspace slug to restrict the search to."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25,
              "description": "Max documents. Defaults to 8."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_contacts",
        "title": "List contacts",
        "description": "List or search the signed-in user's contacts, with company, role and confidence score.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "minLength": 1,
              "description": "Match against name or company."
            },
            "org": {
              "type": "string",
              "description": "Workspace slug to filter by."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max rows. Defaults to 25."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_agent_proposals",
        "title": "List agent proposals",
        "description": "List proposals agents have raised for the signed-in user, with rationale, confidence and approval state. Read-only — approving a proposal stays a human action inside the app.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "org": {
              "type": "string",
              "description": "Workspace slug to filter by."
            },
            "state": {
              "type": "string",
              "description": "Filter by proposal state, e.g. 'pending'."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max rows. Defaults to 20."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
